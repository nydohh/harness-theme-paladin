    "l-float": 0.997,
    "l-accent": 0.93,
    "foreground": "oklch(0.27 0.045 68)",
    "secondary-foreground": "oklch(0.3 0.05 70)",
    "muted-foreground": "oklch(0.5 0.055 75)",
    "accent-foreground": "oklch(0.3 0.05 70)",
    "border": "oklch(0.87 0.055 86)",
    "input": "oklch(0.86 0.06 86)",
    "sidebar-border": "oklch(0.87 0.055 86)",
    "primary": "oklch(0.74 0.135 80)",
    "primary-foreground": "oklch(0.24 0.05 65)",
    "ring": "oklch(0.78 0.14 85)",
    "glass-edge": "oklch(1 0.03 95 / 0.8)",
    "shadow-panel": "0 0 0 1px oklch(0.85 0.08 86 / 0.7), 0 6px 30px -12px oklch(0.75 0.14 82 / 0.45)",
    "shadow-pop": "0 0 0 1px oklch(0.85 0.08 86 / 0.8), 0 14px 40px -12px oklch(0.6 0.12 75 / 0.45)"
  },
  "dark": {
    "sf-h": 268,
    "sf-c": 0.045,
    "l-frame": 0.15,
    "l-list": 0.19,
    "l-content": 0.215,
    "l-card": 0.255,
    "l-float": 0.28,
    "l-accent": 0.32,
    "foreground": "oklch(0.96 0.025 90)",
    "secondary-foreground": "oklch(0.96 0.025 90)",
    "muted-foreground": "oklch(0.76 0.05 85)",
    "accent-foreground": "oklch(0.96 0.025 90)",
    "border": "oklch(0.8 0.1 85 / 16%)",
    "input": "oklch(0.8 0.1 85 / 22%)",
    "sidebar-border": "oklch(0.8 0.1 85 / 12%)",
    "primary": "oklch(0.8 0.14 85)",
    "primary-foreground": "oklch(0.2 0.04 70)",
    "ring": "oklch(0.8 0.14 85)",
    "glass-edge": "oklch(0.9 0.1 90 / 0.18)",
    "shadow-panel": "0 0 0 1px oklch(0.8 0.12 85 / 0.18), 0 8px 34px -14px oklch(0.8 0.15 85 / 0.35)",
    "shadow-pop": "0 0 0 1px oklch(0.8 0.12 85 / 0.25), 0 14px 40px -12px rgb(0 0 0 / 0.7)"
  },
  "css": [
    "& :is(button, a, [role='button'], [role='menuitem'], [role='option']) {",
    "  transition: box-shadow 0.7s ease-out, background-color 0.15s, color 0.15s, border-color 0.15s, opacity 0.15s;",
    "}",
    "& :is(button:not(:disabled), a, [role='button'], [role='menuitem'], [role='option']):active {",
    "  transition-duration: 0s;",
    "  box-shadow: 0 0 0 4px oklch(0.9 0.15 90 / 0.45), 0 0 24px 6px oklch(0.85 0.15 88 / 0.45);",
    "}",
    "& .mx-lg-btn:hover {",
    "  box-shadow: inset 0 1px 0 var(--lg-spec), var(--lg-drop), 0 0 16px -4px oklch(0.85 0.15 88 / 0.55);",
    "}",
    "& .mx-lg:not(:has(textarea)) { transition: box-shadow 0.4s ease; }",
    "& .mx-lg:not(:has(textarea)):hover {",
    "  box-shadow: inset 0 1px 0 var(--lg-spec), var(--lg-drop), 0 0 0 1px oklch(0.82 0.12 86 / 0.45), 0 0 28px -10px oklch(0.85 0.15 88 / 0.55);",
    "}",
    "@media (prefers-reduced-motion: reduce) { & :is(button, a, [role='button'], [role='menuitem'], [role='option']) { transition: none; } }",
    "& :is(button, a).bg-primary {",
    "  background-image: linear-gradient(110deg, oklch(0.62 0.13 70) 0%, oklch(0.8 0.14 85) 30%, oklch(0.93 0.09 95) 46%, oklch(1 0.02 95) 50%, oklch(0.93 0.09 95) 54%, oklch(0.8 0.14 85) 70%, oklch(0.62 0.13 70) 100%);",
    "  background-size: 260% 100%;",
    "  background-position: 100% 0;",
    "  box-shadow: inset 0 1px 0 oklch(1 0 0 / 0.55), 0 0 0 1px oklch(0.62 0.13 70), 0 2px 12px -3px oklch(0.85 0.15 88 / 0.55);",
    "  text-shadow: 0 1px 0 oklch(1 0.03 95 / 0.45);",
    "  transition: background-position 0.7s ease, box-shadow 0.3s ease, transform 0.15s ease;",
    "}",
    "& :is(button, a).bg-primary:hover {",
    "  background-position: 0 0;",
    "  box-shadow: inset 0 1px 0 oklch(1 0 0 / 0.6), 0 0 0 1px oklch(0.62 0.13 70), 0 0 22px -2px oklch(0.85 0.15 88 / 0.55);",
    "}",
    "& :is(button, a).bg-primary:active {",
    "  transform: translateY(1px);",
    "  box-shadow: inset 0 1px 0 oklch(1 0 0 / 0.6), 0 0 0 1px oklch(0.62 0.13 70), 0 0 0 6px oklch(0.9 0.15 90 / 0.35), 0 0 26px 4px oklch(0.85 0.15 88 / 0.5);",
    "}",
    "& ::selection { background: oklch(0.88 0.12 88 / 0.6); }",
    "& :focus-visible { outline-color: oklch(0.8 0.14 85); }",
    "& * { scrollbar-color: oklch(0.78 0.11 84 / 0.7) transparent; }",
    "@media (prefers-reduced-motion: reduce) { & :is(button, a).bg-primary { transition: none; } }"
  ]
}
