{
  "schema": 1,
  "id": "paladin",
  "name": {
    "en": "Paladin",
    "fr": "Paladin"
  },
  "description": {
    "en": "Holy light: ivory and gold by day, a sacred night of deep blue and gold after dark. An animated sky of rays and rising motes of light, gilded buttons, a halo of light on every click, a knight for a logo.",
    "fr": "Lumière sacrée : ivoire et or le jour, nuit sacrée bleu profond et or le soir. Ciel animé de rayons et de particules de lumière qui montent, boutons dorés, halo de lumière à chaque clic, un chevalier pour logo."
  },
  "author": "nydohh",
  "version": "1.1.1",
  "base": "glass",
  "wallpaper": "wallpaper.webp",
  "wallpaper_dark": "wallpaper-dark.webp",
  "logo": "logo.png",
  "preview": "preview.png",
  "options": {
    "mode": "system"
  },
  "light": {
    "sf-h": 84,
    "sf-c": 0.028,
    "l-frame": 0.938,
    "l-list": 0.962,
